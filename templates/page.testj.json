    "custom_liquid_36JVnP": {
      "type": "custom-liquid",
      "name": "t:sections.custom-liquid.presets.name",
      "settings": {
        "custom_liquid": "<div class=\"youtube-feed-section\">\n\n  <div class=\"youtube-feed-header\">\n    <h2>Latest Videos</h2>\n\n    <a\n      href=\"https://www.youtube.com/channel/UCqdcfoz9hDXCXbJDaklkwjQ\"\n      target=\"_blank\"\n      rel=\"noopener\"\n      class=\"youtube-channel-link\"\n    >\n      View Channel\n    </a>\n  </div>\n\n\n  <div class=\"youtube-feed-shell\">\n\n    <button\n      class=\"youtube-feed-arrow youtube-feed-arrow-left\"\n      type=\"button\"\n      aria-label=\"Previous videos\"\n    >\n      &#10094;\n    </button>\n\n\n    <div\n      id=\"YoutubeVideoRail\"\n      class=\"youtube-video-rail\"\n    >\n      <div class=\"youtube-loading\">\n        Loading videos...\n      </div>\n    </div>\n\n\n    <button\n      class=\"youtube-feed-arrow youtube-feed-arrow-right\"\n      type=\"button\"\n      aria-label=\"Next videos\"\n    >\n      &#10095;\n    </button>\n\n  </div>\n\n</div>\n\n\n<div\n  id=\"YoutubeVideoModal\"\n  class=\"youtube-video-modal\"\n  aria-hidden=\"true\"\n>\n\n  <div class=\"youtube-modal-backdrop\"></div>\n\n  <div class=\"youtube-modal-content\">\n\n    <button\n      id=\"YoutubeModalClose\"\n      class=\"youtube-modal-close\"\n      type=\"button\"\n      aria-label=\"Close video\"\n    >\n      &times;\n    </button>\n\n    <div class=\"youtube-player-wrapper\">\n\n      <iframe\n        id=\"YoutubeModalPlayer\"\n        src=\"\"\n        title=\"YouTube video player\"\n        frameborder=\"0\"\n        allow=\"\n          accelerometer;\n          autoplay;\n          clipboard-write;\n          encrypted-media;\n          gyroscope;\n          picture-in-picture;\n          web-share\n        \"\n        allowfullscreen\n      ></iframe>\n\n    </div>\n\n  </div>\n\n</div>\n\n\n<style>\n\n  .youtube-feed-section {\n    width: 100%;\n    max-width: 1400px;\n    margin: 0 auto;\n\n    padding: 20px;\n\n    box-sizing: border-box;\n  }\n\n\n  /* =========================\n     HEADER\n     ========================= */\n\n  .youtube-feed-header {\n    display: flex;\n\n    align-items: center;\n    justify-content: space-between;\n\n    margin-bottom: 16px;\n  }\n\n  .youtube-feed-header h2 {\n    margin: 0;\n\n    color: #ffffff;\n\n    font-size: 24px;\n    font-weight: 700;\n  }\n\n  .youtube-channel-link {\n    color: #ffffff;\n\n    font-size: 14px;\n    font-weight: 600;\n\n    text-decoration: none;\n\n    opacity: 0.8;\n\n    transition: opacity 0.2s ease;\n  }\n\n  .youtube-channel-link:hover {\n    opacity: 1;\n  }\n\n\n  /* =========================\n     CAROUSEL SHELL\n     ========================= */\n\n  .youtube-feed-shell {\n    position: relative;\n\n    width: 100%;\n  }\n\n\n  /* =========================\n     HORIZONTAL RAIL\n     ========================= */\n\n  .youtube-video-rail {\n    display: flex;\n\n    gap: 16px;\n\n    overflow-x: auto;\n\n    scroll-behavior: smooth;\n    scroll-snap-type: x mandatory;\n\n    scrollbar-width: none;\n\n    padding: 2px;\n  }\n\n  .youtube-video-rail::-webkit-scrollbar {\n    display: none;\n  }\n\n\n  /* =========================\n     VIDEO CARD\n     ========================= */\n\n  .youtube-video-card {\n    position: relative;\n\n    flex: 0 0 calc(\n      (100% - 48px) / 4\n    );\n\n    aspect-ratio: 16 / 9;\n\n    overflow: hidden;\n\n    border-radius: 10px;\n\n    background: #111111;\n\n    cursor: pointer;\n\n    scroll-snap-align: start;\n\n    text-decoration: none;\n  }\n\n\n  .youtube-video-thumbnail {\n    position: absolute;\n\n    width: 100%;\n    height: 100%;\n\n    inset: 0;\n\n    object-fit: cover;\n\n    transition:\n      transform 0.25s ease,\n      opacity 0.25s ease;\n  }\n\n\n  .youtube-video-card:hover\n  .youtube-video-thumbnail {\n    transform: scale(1.03);\n  }\n\n\n  /* =========================\n     DARK OVERLAY\n     ========================= */\n\n  .youtube-video-overlay {\n    position: absolute;\n\n    inset: 0;\n\n    display: flex;\n\n    flex-direction: column;\n    justify-content: space-between;\n\n    padding: 14px;\n\n    box-sizing: border-box;\n\n    background:\n      linear-gradient(\n        to bottom,\n        rgba(0,0,0,0.05) 35%,\n        rgba(0,0,0,0.82) 100%\n      );\n  }\n\n\n  /* =========================\n     TITLE\n     ========================= */\n\n  .youtube-video-title {\n    margin-top: auto;\n\n    padding-right: 10px;\n\n    color: #ffffff;\n\n    font-size: 14px;\n    font-weight: 600;\n\n    line-height: 1.3;\n\n    display: -webkit-box;\n\n    -webkit-line-clamp: 2;\n    -webkit-box-orient: vertical;\n\n    overflow: hidden;\n  }\n\n\n  /* =========================\n     PLAY BUTTON\n     ========================= */\n\n  .youtube-play-button {\n    position: absolute;\n\n    top: 50%;\n    left: 50%;\n\n    width: 58px;\n    height: 40px;\n\n    transform:\n      translate(-50%, -50%);\n\n    border-radius: 10px;\n\n    background: rgba(255, 0, 0, 0.95);\n\n    display: flex;\n\n    align-items: center;\n    justify-content: center;\n\n    transition:\n      transform 0.2s ease;\n  }\n\n  .youtube-play-button::after {\n    content: \"\";\n\n    margin-left: 4px;\n\n    width: 0;\n    height: 0;\n\n    border-top: 9px solid transparent;\n    border-bottom: 9px solid transparent;\n\n    border-left:\n      15px solid #ffffff;\n  }\n\n\n  .youtube-video-card:hover\n  .youtube-play-button {\n    transform:\n      translate(-50%, -50%)\n      scale(1.08);\n  }\n\n\n  /* =========================\n     ARROWS\n     ========================= */\n\n  .youtube-feed-arrow {\n    position: absolute;\n\n    top: 50%;\n\n    z-index: 5;\n\n    width: 42px;\n    height: 42px;\n\n    transform: translateY(-50%);\n\n    border: none;\n    border-radius: 50%;\n\n    background:\n      rgba(20, 20, 20, 0.85);\n\n    color: #ffffff;\n\n    font-size: 20px;\n\n    cursor: pointer;\n\n    transition:\n      background 0.2s ease,\n      transform 0.2s ease;\n  }\n\n  .youtube-feed-arrow:hover {\n    background:\n      rgba(40, 40, 40, 1);\n  }\n\n  .youtube-feed-arrow-left {\n    left: -18px;\n  }\n\n  .youtube-feed-arrow-right {\n    right: -18px;\n  }\n\n\n  /* =========================\n     LOADING / ERROR\n     ========================= */\n\n  .youtube-loading,\n  .youtube-error {\n    width: 100%;\n\n    padding: 30px;\n\n    text-align: center;\n\n    color: #ffffff;\n\n    opacity: 0.8;\n  }\n\n\n  /* =========================\n     MODAL\n     ========================= */\n\n  .youtube-video-modal {\n    position: fixed;\n\n    inset: 0;\n\n    z-index: 99999;\n\n    display: none;\n\n    align-items: center;\n    justify-content: center;\n  }\n\n\n  .youtube-video-modal.is-open {\n    display: flex;\n  }\n\n\n  .youtube-modal-backdrop {\n    position: absolute;\n\n    inset: 0;\n\n    background:\n      rgba(0,0,0,0.88);\n  }\n\n\n  .youtube-modal-content {\n    position: relative;\n\n    z-index: 2;\n\n    width: min(\n      1100px,\n      calc(100% - 40px)\n    );\n  }\n\n\n  .youtube-player-wrapper {\n    position: relative;\n\n    width: 100%;\n\n    aspect-ratio: 16 / 9;\n\n    overflow: hidden;\n\n    background: #000000;\n\n    border-radius: 10px;\n  }\n\n\n  .youtube-player-wrapper iframe {\n    position: absolute;\n\n    inset: 0;\n\n    width: 100%;\n    height: 100%;\n  }\n\n\n  .youtube-modal-close {\n    position: absolute;\n\n    right: -8px;\n    top: -48px;\n\n    z-index: 5;\n\n    border: none;\n\n    background: transparent;\n\n    color: #ffffff;\n\n    font-size: 42px;\n\n    line-height: 1;\n\n    cursor: pointer;\n  }\n\n\n  /* =========================\n     TABLET\n     ========================= */\n\n  @media screen and (max-width: 900px) {\n\n    .youtube-video-card {\n      flex-basis:\n        calc(\n          (100% - 16px) / 2\n        );\n    }\n\n  }\n\n\n  /* =========================\n     MOBILE\n     ========================= */\n\n  @media screen and (max-width: 600px) {\n\n    .youtube-feed-section {\n      padding: 16px;\n    }\n\n    .youtube-feed-header h2 {\n      font-size: 20px;\n    }\n\n    .youtube-video-card {\n      flex-basis: 85%;\n    }\n\n    .youtube-feed-arrow {\n      display: none;\n    }\n\n  }\n\n</style>\n\n\n<script>\n\n(function() {\n\n  /* ========================================\n     SETTINGS\n     ======================================== */\n\n  const API_KEY =\n    'AIzaSyBtjbdLtUsePgV9OmGrovUZRepHpEGiLd8';\n\n  const CHANNEL_ID =\n    'UCqdcfoz9hDXCXbJDaklkwjQ';\n\n  const VIDEO_COUNT = 12;\n\n\n  /* ========================================\n     ELEMENTS\n     ======================================== */\n\n  const rail =\n    document.getElementById(\n      'YoutubeVideoRail'\n    );\n\n  const leftArrow =\n    document.querySelector(\n      '.youtube-feed-arrow-left'\n    );\n\n  const rightArrow =\n    document.querySelector(\n      '.youtube-feed-arrow-right'\n    );\n\n  const modal =\n    document.getElementById(\n      'YoutubeVideoModal'\n    );\n\n  const modalPlayer =\n    document.getElementById(\n      'YoutubeModalPlayer'\n    );\n\n  const modalClose =\n    document.getElementById(\n      'YoutubeModalClose'\n    );\n\n  const modalBackdrop =\n    modal.querySelector(\n      '.youtube-modal-backdrop'\n    );\n\n\n  /* ========================================\n     GET CHANNEL UPLOAD PLAYLIST\n     ======================================== */\n\n  async function getUploadsPlaylist() {\n\n    const url =\n      'https://www.googleapis.com/youtube/v3/channels' +\n      '?part=contentDetails' +\n      '&id=' +\n      encodeURIComponent(CHANNEL_ID) +\n      '&key=' +\n      encodeURIComponent(API_KEY);\n\n\n    const response =\n      await fetch(url);\n\n\n    if (!response.ok) {\n\n      throw new Error(\n        'Unable to retrieve YouTube channel.'\n      );\n\n    }\n\n\n    const data =\n      await response.json();\n\n\n    if (\n      !data.items ||\n      !data.items.length\n    ) {\n\n      throw new Error(\n        'YouTube channel was not found.'\n      );\n\n    }\n\n\n    return (\n      data\n        .items[0]\n        .contentDetails\n        .relatedPlaylists\n        .uploads\n    );\n\n  }\n\n\n  /* ========================================\n     GET RECENT VIDEOS\n     ======================================== */\n\n  async function getVideos(\n    playlistId\n  ) {\n\n    const url =\n      'https://www.googleapis.com/youtube/v3/playlistItems' +\n      '?part=snippet,contentDetails' +\n      '&playlistId=' +\n      encodeURIComponent(playlistId) +\n      '&maxResults=' +\n      VIDEO_COUNT +\n      '&key=' +\n      encodeURIComponent(API_KEY);\n\n\n    const response =\n      await fetch(url);\n\n\n    if (!response.ok) {\n\n      throw new Error(\n        'Unable to retrieve YouTube videos.'\n      );\n\n    }\n\n\n    const data =\n      await response.json();\n\n\n    return data.items || [];\n\n  }\n\n\n  /* ========================================\n     BUILD VIDEO CARDS\n     ======================================== */\n\n  function renderVideos(videos) {\n\n    rail.innerHTML = '';\n\n\n    videos.forEach(function(item) {\n\n      const videoId =\n        item.contentDetails.videoId;\n\n      const title =\n        item.snippet.title;\n\n      const thumbnails =\n        item.snippet.thumbnails || {};\n\n\n      const thumbnail =\n        thumbnails.maxres?.url ||\n        thumbnails.standard?.url ||\n        thumbnails.high?.url ||\n        thumbnails.medium?.url ||\n        thumbnails.default?.url;\n\n\n      if (\n        !videoId ||\n        !thumbnail\n      ) {\n\n        return;\n\n      }\n\n\n      const card =\n        document.createElement('div');\n\n      card.className =\n        'youtube-video-card';\n\n      card.tabIndex = 0;\n\n      card.setAttribute(\n        'role',\n        'button'\n      );\n\n      card.setAttribute(\n        'aria-label',\n        'Play ' + title\n      );\n\n\n      const image =\n        document.createElement('img');\n\n      image.className =\n        'youtube-video-thumbnail';\n\n      image.src =\n        thumbnail;\n\n      image.alt =\n        title;\n\n      image.loading =\n        'lazy';\n\n\n      const overlay =\n        document.createElement('div');\n\n      overlay.className =\n        'youtube-video-overlay';\n\n\n      const titleElement =\n        document.createElement('div');\n\n      titleElement.className =\n        'youtube-video-title';\n\n      titleElement.textContent =\n        title;\n\n\n      const play =\n        document.createElement('div');\n\n      play.className =\n        'youtube-play-button';\n\n\n      overlay.appendChild(\n        titleElement\n      );\n\n      card.appendChild(\n        image\n      );\n\n      card.appendChild(\n        overlay\n      );\n\n      card.appendChild(\n        play\n      );\n\n\n      card.addEventListener(\n        'click',\n        function() {\n\n          openVideo(videoId);\n\n        }\n      );\n\n\n      card.addEventListener(\n        'keydown',\n        function(event) {\n\n          if (\n            event.key === 'Enter' ||\n            event.key === ' '\n          ) {\n\n            event.preventDefault();\n\n            openVideo(videoId);\n\n          }\n\n        }\n      );\n\n\n      rail.appendChild(\n        card\n      );\n\n    });\n\n  }\n\n\n  /* ========================================\n     VIDEO MODAL\n     ======================================== */\n\n  function openVideo(videoId) {\n\n    modalPlayer.src =\n      'https://www.youtube.com/embed/' +\n      encodeURIComponent(videoId) +\n      '?autoplay=1&rel=0';\n\n\n    modal.classList.add(\n      'is-open'\n    );\n\n    modal.setAttribute(\n      'aria-hidden',\n      'false'\n    );\n\n\n    document.body.style.overflow =\n      'hidden';\n\n  }\n\n\n  function closeVideo() {\n\n    modalPlayer.src = '';\n\n    modal.classList.remove(\n      'is-open'\n    );\n\n    modal.setAttribute(\n      'aria-hidden',\n      'true'\n    );\n\n\n    document.body.style.overflow =\n      '';\n\n  }\n\n\n  modalClose.addEventListener(\n    'click',\n    closeVideo\n  );\n\n\n  modalBackdrop.addEventListener(\n    'click',\n    closeVideo\n  );\n\n\n  document.addEventListener(\n    'keydown',\n    function(event) {\n\n      if (\n        event.key === 'Escape' &&\n        modal.classList.contains(\n          'is-open'\n        )\n      ) {\n\n        closeVideo();\n\n      }\n\n    }\n  );\n\n\n  /* ========================================\n     CAROUSEL ARROWS\n     ======================================== */\n\n  leftArrow.addEventListener(\n    'click',\n    function() {\n\n      rail.scrollBy({\n        left:\n          -rail.clientWidth,\n        behavior:\n          'smooth'\n      });\n\n    }\n  );\n\n\n  rightArrow.addEventListener(\n    'click',\n    function() {\n\n      rail.scrollBy({\n        left:\n          rail.clientWidth,\n        behavior:\n          'smooth'\n      });\n\n    }\n  );\n\n\n  /* ========================================\n     LOAD\n     ======================================== */\n\n  async function loadYouTubeFeed() {\n\n    try {\n\n      const uploadsPlaylist =\n        await getUploadsPlaylist();\n\n\n      const videos =\n        await getVideos(\n          uploadsPlaylist\n        );\n\n\n      renderVideos(videos);\n\n    }\n\n    catch (error) {\n\n      console.error(\n        'YouTube feed error:',\n        error\n      );\n\n\n      rail.innerHTML =\n        '<div class=\"youtube-error\">' +\n        'Unable to load videos.' +\n        '</div>';\n\n    }\n\n  }\n\n\n  loadYouTubeFeed();\n\n})();\n\n</script>",
        "color_scheme": "",
        "padding_top": 40,
        "padding_bottom": 52
      }
    },
    "custom_liquid_C3iwwQ": {
      "type": "custom-liquid",
      "name": "t:sections.custom-liquid.presets.name",
      "settings": {
        "custom_liquid": "{% assign selected_collection = collections['bricky'] %}\n\n<div class=\"custom-product-grid-section\">\n\n  {% if selected_collection != blank %}\n\n    <div class=\"custom-product-grid-header\">\n\n      <div class=\"custom-product-count\">\n        {{ selected_collection.products_count }}\n        {% if selected_collection.products_count == 1 %}\n          Product\n        {% else %}\n          Products\n        {% endif %}\n      </div>\n\n      <div class=\"custom-sort-wrapper\">\n\n        <label for=\"CustomSort\">\n          Sort by\n        </label>\n\n        <select id=\"CustomSort\" class=\"custom-sort-select\">\n          <option value=\"manual\">Featured</option>\n          <option value=\"title-ascending\">Alphabetically, A–Z</option>\n          <option value=\"title-descending\">Alphabetically, Z–A</option>\n          <option value=\"price-ascending\">Price, low to high</option>\n          <option value=\"price-descending\">Price, high to low</option>\n          <option value=\"type-ascending\">Type, A–Z</option>\n          <option value=\"type-descending\">Type, Z–A</option>\n        </select>\n\n      </div>\n\n    </div>\n\n\n    <div id=\"CustomProductGrid\" class=\"custom-product-grid\">\n\n      {% for product in selected_collection.products %}\n\n        <a\n          href=\"{{ product.url }}\"\n          class=\"custom-product-card\"\n          data-title=\"{{ product.title | escape }}\"\n          data-price=\"{{ product.price }}\"\n          data-type=\"{{ product.type | escape }}\"\n          data-position=\"{{ forloop.index }}\"\n        >\n\n          <div class=\"custom-product-image\">\n\n            {% if product.featured_image %}\n\n              {{\n                product.featured_image\n                | image_url: width: 1200\n                | image_tag:\n                  loading: 'lazy',\n                  widths: '400, 600, 800, 1200',\n                  sizes: '(min-width: 900px) 33vw, (min-width: 600px) 50vw, 100vw',\n                  alt: product.featured_image.alt | default: product.title\n              }}\n\n            {% else %}\n\n              <div class=\"custom-product-placeholder\">\n                No image\n              </div>\n\n            {% endif %}\n\n          </div>\n\n\n          <div class=\"custom-product-info\">\n\n            <div class=\"custom-product-title\">\n              {{ product.title }}\n            </div>\n\n            <div class=\"custom-product-price\">\n\n              {% if product.compare_at_price > product.price %}\n\n                <span class=\"custom-product-sale-price\">\n                  {{ product.price | money }}\n                </span>\n\n                <span class=\"custom-product-compare-price\">\n                  {{ product.compare_at_price | money }}\n                </span>\n\n              {% else %}\n\n                {{ product.price | money }}\n\n              {% endif %}\n\n            </div>\n\n          </div>\n\n        </a>\n\n      {% endfor %}\n\n    </div>\n\n\n  {% else %}\n\n    <div class=\"custom-product-grid-empty\">\n      Collection not found. Check the collection handle.\n    </div>\n\n  {% endif %}\n\n</div>\n\n\n<style>\n\n  .custom-product-grid-section {\n    width: 100%;\n    max-width: 1400px;\n    margin: 0 auto;\n    padding: 20px;\n    box-sizing: border-box;\n  }\n\n\n  /* =========================\n     SORTING HEADER\n     ========================= */\n\n  .custom-product-grid-header {\n    width: 100%;\n    display: flex;\n    justify-content: flex-end;\n    align-items: center;\n    margin-bottom: 24px;\n  }\n\n  .custom-product-count {\n    margin-right: auto;\n\n    font-size: 14px;\n    font-weight: 500;\n    color: #ffffff;\n  }\n\n  .custom-sort-wrapper {\n    display: flex;\n    align-items: center;\n    gap: 10px;\n  }\n\n  .custom-sort-wrapper label {\n    font-size: 14px;\n    font-weight: 600;\n    color: #ffffff;\n  }\n\n  .custom-sort-select {\n    min-width: 220px;\n    height: 42px;\n\n    padding: 0 14px;\n\n    border: 1px solid #7c4a99;\n    border-radius: 8px;\n\n    background-color: #24153d;\n    color: #ffffff;\n\n    font-family: inherit;\n    font-size: 14px;\n    font-weight: 500;\n\n    cursor: pointer;\n  }\n\n\n  /* =========================\n     PRODUCT GRID\n     ========================= */\n\n  .custom-product-grid {\n    display: grid;\n\n    grid-template-columns:\n      repeat(3, minmax(0, 1fr));\n\n    gap: 20px;\n  }\n\n\n  /* =========================\n     PRODUCT CARD\n     ========================= */\n\n  .custom-product-card {\n    display: block;\n\n    overflow: hidden;\n\n    background: #24153d;\n\n    border: 1px solid #7c4a99;\n    border-radius: 8px;\n\n    text-decoration: none;\n    color: inherit;\n\n    transition:\n      transform 0.2s ease,\n      box-shadow 0.2s ease;\n  }\n\n  .custom-product-card:hover {\n    transform: translateY(-2px);\n\n    box-shadow:\n      0 6px 20px rgba(0, 0, 0, 0.15);\n  }\n\n\n  /* =========================\n     PRODUCT IMAGE\n     ========================= */\n\n  .custom-product-image {\n    width: 100%;\n\n    aspect-ratio: 1 / 1;\n\n    overflow: hidden;\n\n    background: #351a4a;\n  }\n\n  .custom-product-image img {\n    width: 100%;\n    height: 100%;\n\n    display: block;\n\n    object-fit: contain;\n\n    transition:\n      transform 0.25s ease;\n  }\n\n  .custom-product-card:hover\n  .custom-product-image img {\n    transform: scale(1.02);\n  }\n\n\n  /* =========================\n     PRODUCT INFO\n     ========================= */\n\n  .custom-product-info {\n    padding: 18px 16px 20px;\n  }\n\n  .custom-product-title {\n    margin-bottom: 8px;\n\n    color: #ffffff;\n\n    font-size: 16px;\n    font-weight: 600;\n\n    line-height: 1.3;\n  }\n\n  .custom-product-price {\n    color: #d49ad9;\n\n    font-size: 16px;\n    font-weight: 600;\n\n    line-height: 1.2;\n  }\n\n  .custom-product-sale-price {\n    color: #ff8fb1;\n  }\n\n  .custom-product-compare-price {\n    margin-left: 6px;\n\n    color: #999999;\n\n    font-size: 0.85em;\n    font-weight: 400;\n\n    text-decoration: line-through;\n  }\n\n\n  /* =========================\n     EMPTY STATE\n     ========================= */\n\n  .custom-product-grid-empty {\n    padding: 50px;\n\n    text-align: center;\n\n    border: 1px solid #7c4a99;\n    border-radius: 8px;\n\n    color: #ffffff;\n  }\n\n\n  /* =========================\n     TABLET\n     ========================= */\n\n  @media screen and (max-width: 900px) {\n\n    .custom-product-grid {\n      grid-template-columns:\n        repeat(2, minmax(0, 1fr));\n    }\n\n  }\n\n\n  /* =========================\n     MOBILE\n     ========================= */\n\n  @media screen and (max-width: 600px) {\n\n    .custom-product-grid-section {\n      padding: 16px;\n    }\n\n    .custom-product-grid-header {\n      align-items: stretch;\n      flex-direction: column;\n      gap: 14px;\n    }\n\n    .custom-sort-wrapper {\n      width: 100%;\n    }\n\n    .custom-sort-select {\n      flex: 1;\n      min-width: 0;\n    }\n\n    .custom-product-grid {\n      grid-template-columns: 1fr;\n      gap: 16px;\n    }\n\n  }\n\n</style>\n\n\n<script>\n\n(function() {\n\n  const sortSelect =\n    document.getElementById('CustomSort');\n\n  const grid =\n    document.getElementById('CustomProductGrid');\n\n  if (!sortSelect || !grid) {\n    return;\n  }\n\n\n  const originalProducts =\n    Array.from(\n      grid.querySelectorAll('.custom-product-card')\n    );\n\n\n  sortSelect.addEventListener('change', function() {\n\n    const sort = this.value;\n\n    const products =\n      Array.from(originalProducts);\n\n\n    /* =========================\n       ALPHABETICAL\n       ========================= */\n\n    if (sort === 'title-ascending') {\n\n      products.sort(function(a, b) {\n\n        return a.dataset.title.localeCompare(\n          b.dataset.title,\n          undefined,\n          {\n            sensitivity: 'base'\n          }\n        );\n\n      });\n\n    }\n\n\n    if (sort === 'title-descending') {\n\n      products.sort(function(a, b) {\n\n        return b.dataset.title.localeCompare(\n          a.dataset.title,\n          undefined,\n          {\n            sensitivity: 'base'\n          }\n        );\n\n      });\n\n    }\n\n\n    /* =========================\n       PRICE\n       ========================= */\n\n    if (sort === 'price-ascending') {\n\n      products.sort(function(a, b) {\n\n        return (\n          Number(a.dataset.price) -\n          Number(b.dataset.price)\n        );\n\n      });\n\n    }\n\n\n    if (sort === 'price-descending') {\n\n      products.sort(function(a, b) {\n\n        return (\n          Number(b.dataset.price) -\n          Number(a.dataset.price)\n        );\n\n      });\n\n    }\n\n\n    /* =========================\n       PRODUCT TYPE\n       ========================= */\n\n    if (sort === 'type-ascending') {\n\n      products.sort(function(a, b) {\n\n        return a.dataset.type.localeCompare(\n          b.dataset.type,\n          undefined,\n          {\n            sensitivity: 'base'\n          }\n        );\n\n      });\n\n    }\n\n\n    if (sort === 'type-descending') {\n\n      products.sort(function(a, b) {\n\n        return b.dataset.type.localeCompare(\n          a.dataset.type,\n          undefined,\n          {\n            sensitivity: 'base'\n          }\n        );\n\n      });\n\n    }\n\n\n    /* =========================\n       FEATURED / ORIGINAL ORDER\n       ========================= */\n\n    if (sort === 'manual') {\n\n      products.sort(function(a, b) {\n\n        return (\n          Number(a.dataset.position) -\n          Number(b.dataset.position)\n        );\n\n      });\n\n    }\n\n\n    /*\n     * Rebuild grid in new order.\n     */\n\n    products.forEach(function(product) {\n\n      grid.appendChild(product);\n\n    });\n\n  });\n\n})();\n\n</script>",
