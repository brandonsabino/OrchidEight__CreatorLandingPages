        "custom_liquid": "<div class=\"twitch-panel\">\n\n  <div class=\"twitch-panel-header\">\n    <h2>Live on Twitch</h2>\n\n    <a\n      href=\"https://www.twitch.tv/bricky\"\n      target=\"_blank\"\n      rel=\"noopener\"\n      class=\"twitch-panel-link\"\n    >\n      View Channel\n    </a>\n  </div>\n\n  <div class=\"twitch-player-wrapper\">\n\n    <iframe\n      src=\"https://player.twitch.tv/?channel=bricky&parent=orchideight.com\"\n      frameborder=\"0\"\n      allowfullscreen=\"true\"\n      scrolling=\"no\"\n      allow=\"autoplay; fullscreen\"\n    ></iframe>\n\n  </div>\n\n</div>\n\n\n<style>\n\n  .twitch-panel {\n    width: 100%;\n    max-width: 1400px;\n    margin: 0 auto;\n    padding: 20px;\n    box-sizing: border-box;\n  }\n\n\n  /* =========================\n     HEADER\n     ========================= */\n\n  .twitch-panel-header {\n    display: flex;\n    align-items: center;\n    justify-content: space-between;\n\n    margin-bottom: 16px;\n  }\n\n  .twitch-panel-header h2 {\n    margin: 0;\n\n    color: #ffffff;\n\n    font-size: 24px;\n    font-weight: 700;\n  }\n\n  .twitch-panel-link {\n    color: #ffffff;\n\n    font-size: 14px;\n    font-weight: 600;\n\n    text-decoration: none;\n\n    opacity: 0.8;\n\n    transition: opacity 0.2s ease;\n  }\n\n  .twitch-panel-link:hover {\n    opacity: 1;\n  }\n\n\n  /* =========================\n     TWITCH PLAYER\n     ========================= */\n\n  .twitch-player-wrapper {\n    position: relative;\n\n    width: 100%;\n\n    aspect-ratio: 16 / 9;\n\n    overflow: hidden;\n\n    border-radius: 10px;\n\n    background: #000000;\n  }\n\n  .twitch-player-wrapper iframe {\n    position: absolute;\n\n    inset: 0;\n\n    width: 100%;\n    height: 100%;\n\n    border: 0;\n  }\n\n\n  /* =========================\n     MOBILE\n     ========================= */\n\n  @media screen and (max-width: 600px) {\n\n    .twitch-panel {\n      padding: 16px;\n    }\n\n    .twitch-panel-header h2 {\n      font-size: 20px;\n    }\n\n  }\n\n</style>",
